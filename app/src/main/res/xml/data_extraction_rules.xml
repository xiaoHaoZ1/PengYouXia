<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的数据提取规则：排除全部数据，保持与 allowBackup=false 一致（资料只在本机） -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
